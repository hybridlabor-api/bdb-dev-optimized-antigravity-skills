{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "bdb_unreal_mcp": {
      "command": "node",
      "args": ["__MCPS_DIR__/unreal_mcp/dist/cli.js"]
    },
    "bdb_rhino_mcp": {
      "command": "uv",
      "args": ["run", "__MCPS_DIR__/rhino_mcp.py"]
    },
    "bdb_davinci_mcp": {
      "command": "uv",
      "args": ["run", "__MCPS_DIR__/davinci_mcp.py"]
    },
    "bdb_grandma3_mcp": {
      "command": "uv",
      "args": ["run", "__MCPS_DIR__/grandma3_mcp.py"]
    },
    "bdb_resolume_mcp": {
      "command": "uv",
      "args": ["run", "__MCPS_DIR__/resolume_mcp.py"]
    },
    "adobe_mcp": {
      "command": "uv",
      "args": ["run", "__MCPS_DIR__/adobe_mcp.py"]
    },
    "adobe_uxp_mcp": {
      "command": "node",
      "args": ["__MCPS_DIR__/adobe_uxp_mcp/index.js"]
    },
    "bdb_td_minddesigner": {
      "command": "npx",
      "args": ["-y", "minddesigner-tdmcp"]
    },
    "bdb_td_backup": {
      "command": "npx",
      "args": ["-y", "touchdesigner-mcp"]
    },
    "zavora_computer_use": {
      "command": "npx",
      "args": ["-y", "@zavora-ai/computer-use-mcp"]
    }
  }
}
